# Copy to .env at the project root (never commit .env)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Jamendo API client_id — enables compliant-mode downloads of free/Creative-Commons
# tracks. Register a free app at https://devportal.jamendo.com. Optional: without it,
# compliant mode still runs (Internet Archive + purchase list), just no Jamendo.
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Optional: folder of MP3s you already own (purchased / ripped). In compliant mode
# a matching owned file is copied into the library instead of downloading. Leave
# unset to disable local import.
MUSIC_IMPORT_FOLDER=
